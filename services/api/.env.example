PORT=3000
HOST=0.0.0.0
# Local Docker Postgres, or the same Neon URL as the marketing site (run `npm run migrate` once).
DATABASE_URL=postgresql://followup:followup@localhost:5432/followup
LOG_LEVEL=info

# OpenAI (lead parsing + /v1/ai/chat)
OPENAI_API_KEY=

# JWT auth (required when SKIP_AUTH=false). Generate strong random strings, e.g. openssl rand -base64 64
JWT_SECRET=
# Refresh tokens are opaque strings stored hashed in DB (not JWT). No separate refresh secret.
# Access / refresh lifetimes (seconds). Defaults: 900 (15m) and 2592000 (30d).
# JWT_ACCESS_EXPIRES_SEC=900
# JWT_REFRESH_EXPIRES_SEC=2592000

# Client Portal auth — MUST be different from JWT_SECRET (separate identity stack).
CLIENT_JWT_SECRET=
# CLIENT_JWT_ACCESS_EXPIRES_SEC=900
# CLIENT_JWT_REFRESH_EXPIRES_SEC=2592000
# Public URL of the client portal app (used in invite + reset emails).
CLIENT_PORTAL_URL=http://localhost:3004
# CLIENT_INVITE_FROM_EMAIL=noreply@curvvtech.com
# Admin app origin used to build one-time staff invitation links.
STAFF_INVITE_BASE_URL=http://localhost:3003

# Legacy (unused by mobile; optional for old tooling)
# COGNITO_REGION=
# COGNITO_USER_POOL_ID=
# COGNITO_CLIENT_ID=

# Local dev: bypass JWT (never in production)
SKIP_AUTH=true
DEV_AUTH_SUB=dev-local-auth-sub
DEV_AUTH_EMAIL=dev@local.followup

# First N signups get access_allowed=true (waitlist after that)
ACCESS_CAP=1000

# Landing site proxy (optional): same secret in Next.js FOLLOWUP_LANDING_API_KEY
LANDING_API_KEY=

# S3 presigned uploads (project files, profile photos)
# AWS_REGION=us-east-1
# S3_BUCKET=your-bucket-name
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# CORS (comma-separated); leave empty to reflect request origin in dev
# CORS_ORIGINS=https://app.example.com

# Redis (optional; enables distributed rate limiting across API instances)
# REDIS_URL=redis://localhost:6379

# WhatsApp Cloud API — webhooks (GET verify + POST) and outbound sends
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-random-string
# WHATSAPP_APP_SECRET=Meta App secret (X-Hub-Signature-256 on POST)
# WHATSAPP_GRAPH_ACCESS_TOKEN=System user / permanent token for Graph API sends
# Production: enforce signature verification (default true). Set false only for emergency debugging.
# REQUIRE_WHATSAPP_SIGNATURE=true
# Link numbers to tenants via whatsapp_accounts (or PATCH /v1/me/whatsapp for the first tenant).

# --- Resend (PRIMARY email provider for ALL outbound mail: portal invites,
#     password resets, demo invites, workflow emails, notifications) ---
# Create an API key + verify your sending domain at https://resend.com
RESEND_API_KEY=
# Default From (must be on a Resend-verified domain). Display name is optional.
EMAIL_FROM=Curvvtech <noreply@curvvtech.in>
# Optional global Reply-To for all system emails.
# EMAIL_REPLY_TO=advaitsingh@curvvtech.in

# Google OAuth — Settings → Integrations (Calendar creates Meet links for career interviews).
# Google Cloud → APIs & Services → Credentials → Web client.
# Authorized redirect URI must match GOOGLE_OAUTH_REDIRECT_URI exactly.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# API_PUBLIC_URL=https://api.curvvtech.in
# GOOGLE_OAUTH_REDIRECT_URI=https://api.curvvtech.in/api/admin/integrations/oauth/callback
# ADMIN_PANEL_URL=https://admin.curvvtech.com

# Demo booking — calendar invites when admin clicks "Confirm".
# Only used as an SMTP fallback if RESEND_API_KEY is unset (Google Workspace: use an App Password).
# DEMO_SMTP_HOST=smtp.gmail.com
# DEMO_SMTP_PORT=587
# DEMO_SMTP_SECURE=false
# DEMO_SMTP_USER=advaitsingh@curvvtech.in
# DEMO_SMTP_PASS=your-app-password
# DEMO_CALENDAR_FROM_EMAIL=advaitsingh@curvvtech.in
# DEMO_CALENDAR_ORGANIZER_NAME=Curvvtech
# DEMO_MEETING_TITLE=Curvvtech · FollowUp product demo
# DEMO_MEETING_LOCATION=Online — meeting link will be shared separately

# Razorpay — Standard Checkout + FollowUp SaaS billing
# Standard Checkout: POST /api/create-order, POST /api/verify-payment
# FollowUp billing webhook: POST /api/v1/billing/webhooks/razorpay
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# RAZORPAY_PLAN_PRO_MONTHLY=
# RAZORPAY_PLAN_PRO_ANNUAL=
# RAZORPAY_PLAN_PRO_PLUS_MONTHLY=
# RAZORPAY_PLAN_PRO_PLUS_ANNUAL=
