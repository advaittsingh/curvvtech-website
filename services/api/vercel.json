{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "installCommand": "npm install --legacy-peer-deps",
  "builds": [
    {
      "src": "api/index.ts",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 60,
        "includeFiles": "src/templates/email/**"
      }
    }
  ],
  "routes": [{ "src": "/(.*)", "dest": "/api/index.ts" }]
}
