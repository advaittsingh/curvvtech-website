{
  "name": "@curvvtech/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc && node -e \"const fs=require('fs');const path=require('path');const src='src/templates/email';const dist='dist/templates/email';fs.mkdirSync(dist,{recursive:true});fs.mkdirSync(path.join(dist,'assets'),{recursive:true});fs.copyFileSync(path.join(src,'invite-email.html'),path.join(dist,'invite-email.html'));for (const f of ['curvvtech-logo.png','curvvtech-logo-white.png']) fs.copyFileSync(path.join(src,'assets',f),path.join(dist,'assets',f))\"",
    "vercel-build": "echo skip-compile",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "migrate": "node scripts/migrate.mjs",
    "create-admin": "node scripts/create-curvvtech-admin.mjs",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy:vercel": "vercel deploy --prod --yes --scope curvvtech",
    "vercel:link": "vercel link --yes --scope curvvtech --project curvvtech-api"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.744.0",
    "@aws-sdk/s3-request-presigner": "^3.744.0",
    "@deepgram/sdk": "^5.0.0",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.73.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.5.0",
    "ioredis": "^5.4.2",
    "jose": "^5.9.6",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^8.0.4",
    "openai": "^6.33.0",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "razorpay": "^2.9.6",
    "resend": "^6.17.1",
    "socket.io": "^4.7.2",
    "twilio": "^4.19.0",
    "ws": "^8.18.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^6.4.23",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.1.4"
  }
}
